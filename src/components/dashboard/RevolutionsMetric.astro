---
/**
 * Operational Status Component
 * Displays In Bedrijf (in operation) status and RPM (revolutions per minute)
 */
---

<div class="card">
    <h2>
        <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Operational Status
    </h2>

    <div class="metrics-grid">
        <!-- In Bedrijf (ind) Card -->
        <div class="metric-card">
            <div class="status-display" id="indCard">
                <div class="status-icon" aria-hidden="true">💧</div>
                <div class="status-data">
                    <div class="status-value" id="indValue" aria-label="In Bedrijf Status">false</div>
                    <div class="status-label">In Operation</div>
                </div>
            </div>
        </div>

        <!-- RPM Display -->
        <div class="metric-card">
            <div class="rpm-display" id="rpmCard">
                <div class="rpm-icon" aria-hidden="true">⚡</div>
                <div class="rpm-data">
                    <div class="rpm-value" id="rpm" aria-label="RPM">0.00</div>
                    <div class="rpm-label">RPM</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Horizontal metrics grid */
    .metrics-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 1rem;
    }

    .metric-card {
        /* Removed hover effect */
    }

    /* In Bedrijf Status Display */
    .status-display {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1.25rem;
        background: rgba(15, 23, 42, 0.4);
        border: 2px solid rgba(100, 116, 139, 0.1);
        border-radius: 10px;
        height: 100%;
    }

    .status-icon {
        font-size: 1.75rem;
        width: 2.5rem;
        height: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(100, 116, 139, 0.1);
        border-radius: 8px;
        flex-shrink: 0;
    }

    .status-data {
        flex: 1;
    }

    .status-label {
        font-size: 0.75rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 600;
        margin-top: 0.25rem;
    }

    .status-value {
        font-size: 2rem;
        font-weight: 800;
        color: #38bdf8;
        line-height: 1;
    }

    /* RPM Display */
    .rpm-display {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1.25rem;
        background: rgba(15, 23, 42, 0.4);
        border: 2px solid rgba(100, 116, 139, 0.1);
        border-radius: 10px;
        height: 100%;
    }

    .rpm-icon {
        font-size: 1.75rem;
        width: 2.5rem;
        height: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(100, 116, 139, 0.1);
        border-radius: 8px;
        flex-shrink: 0;
    }

    .rpm-data {
        flex: 1;
    }

    .rpm-value {
        font-size: 2rem;
        font-weight: 800;
        color: #38bdf8;
        line-height: 1;
    }

    .rpm-label {
        font-size: 0.75rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 600;
        margin-top: 0.25rem;
    }

    /* Light mode overrides */
    :global(body.light-mode) .status-display,
    :global(body.light-mode) .rpm-display {
        background: rgba(248, 250, 252, 0.6);
        border-color: rgba(100, 116, 139, 0.15);
    }

    :global(body.light-mode) .status-value,
    :global(body.light-mode) .rpm-value {
        color: #0284c7;
    }

    :global(body.light-mode) .status-label,
    :global(body.light-mode) .rpm-label {
        color: #64748b;
    }

    :global(body.light-mode) .status-icon,
    :global(body.light-mode) .rpm-icon {
        background: rgba(100, 116, 139, 0.08);
    }

    /* Responsive: stack on mobile */
    @media (max-width: 640px) {
        .metrics-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
