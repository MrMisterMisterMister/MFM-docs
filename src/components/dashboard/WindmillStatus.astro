---
/**
 * Poldermill Status Component
 * Displays in bedrijf (in operation) status
 */
---

<div class="card">
    <h2>
        <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Operational Status
    </h2>
    <div class="status-grid-single" role="region" aria-label="Current poldermill operational status">
        <div class="status-card">
            <div class="status-card-label">In Operation</div>
            <div class="status-indicator inactive" id="pumpingStatus" role="status" aria-live="polite">
                <div class="status-icon" aria-hidden="true">💧</div>
                <div class="status-text">
                    <div class="status-text-main">Idle</div>
                    <div class="status-text-sub">Standby</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .status-grid-single {
        display: flex;
        justify-content: center;
        margin-top: 1rem;
    }
</style>
