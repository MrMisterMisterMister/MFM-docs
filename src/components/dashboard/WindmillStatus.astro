---
/**
 * Poldermill Status Component
 * Displays spinning and pumping status indicators
 */
---

<div class="card">
    <h2>
        <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Poldermill Status
    </h2>
    <div class="status-grid" role="region" aria-label="Current poldermill operational status">
        <div class="status-card">
            <div class="status-card-label">Spinning</div>
            <div class="status-indicator inactive" id="spinningStatus" role="status" aria-live="polite">
                <div class="status-icon" aria-hidden="true">⚙️</div>
                <div class="status-text">
                    <div class="status-text-main">Stopped</div>
                    <div class="status-text-sub">No wind</div>
                </div>
            </div>
        </div>
        <div class="status-card">
            <div class="status-card-label">Pumping</div>
            <div class="status-indicator inactive" id="pumpingStatus" role="status" aria-live="polite">
                <div class="status-icon" aria-hidden="true">💧</div>
                <div class="status-text">
                    <div class="status-text-main">Idle</div>
                    <div class="status-text-sub">Standby</div>
                </div>
            </div>
        </div>
    </div>
</div>
